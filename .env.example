# Copy to `.env` next to docker-compose.yml. Consumed by docker-compose itself
# (the Nest app reads its own variables from `server/.production.env`).

# --- MySQL bootstrap (used by services `mysql` and `mysql-dev`) ---
MYSQL_ROOT_PASSWORD=set_forge_root_password
MYSQL_DATABASE=set_forge_db
MYSQL_USER=set_forge_db_user
MYSQL_PASSWORD=set_forge_db_password
# Host port for `mysql-dev` only (bound to 127.0.0.1). Default 3306.
# MYSQL_PUBLIC_PORT=3306

# --- Caddy / HTTPS ---
# Hostname Caddy issues a certificate for and binds to.
#   Local check:     SITE_ADDRESS=localhost                   → internal CA (Caddy Local Authority), HTTPS works on https://localhost.
#   VDS without DNS: SITE_ADDRESS=<ip-with-dashes>.sslip.io   → real Let's Encrypt cert via sslip.io wildcard DNS.
#   Real domain:     SITE_ADDRESS=set-forge.example.com       → real Let's Encrypt cert.
SITE_ADDRESS=localhost

# Host ports Caddy binds to. Override on Windows when 80/443 are held by HTTP.sys / IIS / Skype.
# Example: HTTP_PORT=8080 HTTPS_PORT=8443  →  open https://localhost:8443
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Client build (OG/Twitter meta in index.html) ---
# Public origin for link previews. Must match CLIENT_URL in server/.production.env
# (https://, no trailing slash). Passed as a Docker build arg to client-prod
# (env files are not copied into the image — see .dockerignore).
#   Local check:     VITE_PUBLIC_ORIGIN=https://localhost
#   VDS sslip.io:    VITE_PUBLIC_ORIGIN=https://185-10-20-30.sslip.io
#   Real domain:     VITE_PUBLIC_ORIGIN=https://set-forge.example.com
VITE_PUBLIC_ORIGIN=https://localhost

# Operator identity shown on the /privacy and /terms pages (152-ФЗ requires an identifiable, reachable operator).
# Baked into the SPA build; keep them out of source and set them here. Leave empty to show placeholders.
# Prefer per-language names (RU document vs EN document). VITE_PRIVACY_OPERATOR_NAME is an optional
# shared fallback used for any language left unset. The contact should be a dedicated mailbox
# (not personal/corporate) — it becomes public.
VITE_PRIVACY_OPERATOR_NAME_RU=
VITE_PRIVACY_OPERATOR_NAME_EN=
VITE_PRIVACY_OPERATOR_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
