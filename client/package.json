{
  "name": "@set-forge/client",
  "version": "0.6.2",
  "description": "Build workout lists, log sets and weights, rate perceived effort, and track strength progress over time.",
  "private": true,
  "author": "AlexEvs",
  "bugs": {
    "url": "https://github.com/a1exevs/set-forge/issues"
  },
  "keywords": [
    "exercise lists",
    "workout",
    "training",
    "progress visualization",
    "sport",
    "exercises",
    "workout planning"
  ],
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"{src,.storybook,linter,tests}/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"{src,.storybook,linter,tests}/**/*.{ts,tsx,css,scss}\"",
    "lint": "eslint --config eslint.config.ts src .storybook linter tests eslint.config.ts",
    "lint:fix": "eslint --config eslint.config.ts src .storybook linter tests eslint.config.ts --fix",
    "test:unit": "tsc --noEmit -p tsconfig.spec.json && cross-env TS_NODE_PROJECT=tsconfig.spec.json jest --config tests/unit/config/config.ts",
    "test:unit-cov": "tsc --noEmit -p tsconfig.spec.json && cross-env TS_NODE_PROJECT=tsconfig.spec.json jest --config tests/unit/config/config.ts --coverage",
    "test:snap": "tsc --noEmit -p tsconfig.spec.json && cross-env TS_NODE_PROJECT=tsconfig.spec.json jest --config tests/snap/config/config.ts",
    "test:snap-cov": "tsc --noEmit -p tsconfig.spec.json && cross-env TS_NODE_PROJECT=tsconfig.spec.json jest --config tests/snap/config/config.ts --coverage",
    "test:snap-update": "tsc --noEmit -p tsconfig.spec.json && cross-env TS_NODE_PROJECT=tsconfig.spec.json jest --updateSnapshot --config tests/snap/config/config.ts",
    "test:e2e": "tsc --noEmit -p tsconfig.spec.json && playwright test --config=tests/e2e/config/config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e/config/config.ts --headed --workers=1",
    "test:e2e:ui": "playwright test --config=tests/e2e/config/config.ts --ui",
    "test:e2e:debug": "playwright test --config=tests/e2e/config/config.ts --debug",
    "test": "npm run test:unit && npm run test:snap && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "tsc -p tsconfig.storybook.json && storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "docs": "typedoc",
    "generate:icons": "node scripts/generate-public-icons.mjs",
    "e2e:install": "playwright install --with-deps",
    "check-deps": "npm outdated",
    "upgrade-deps": "npm upgrade --latest"
  },
  "dependencies": {
    "@alexevs/ts-guards": "1.0.9",
    "@headlessui/react": "2.2.10",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "canvas-confetti": "1.9.4",
    "immer": "10.2.0",
    "lucide-react": "1.28.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.4",
    "seroval": "1.5.6",
    "seroval-plugins": "1.5.6",
    "sonner": "2.0.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.0",
    "@babel/plugin-proposal-private-property-in-object": "7.21.11",
    "@chromatic-com/storybook": "3.2.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@storybook/test": "8.6.18",
    "@tanstack/router-devtools": "1.167.0",
    "@tanstack/router-plugin": "1.168.23",
    "@testcontainers/mysql": "12.0.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/canvas-confetti": "1.9.0",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "4.7.0",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-storybook": "0.12.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.4.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jiti": "2.7.0",
    "prettier": "3.5.3",
    "sass": "1.102.0",
    "storybook": "8.6.18",
    "storybook-addon-pseudo-states": "4.0.4",
    "testcontainers": "12.0.4",
    "to-ico": "1.1.5",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3"
  }
}
