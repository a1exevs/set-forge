# Copy to `.env` / `.env.local` for local Vite dev only (not used in Docker prod build).
#
# The app always calls the API through the same-origin `/api/1.0` path.
# In development, Vite proxies `/api` to this target.
# Leave empty for the default local backend: http://localhost:5000
#
# Examples:
# VITE_DEV_API_PROXY=https://staging.example.com
# VITE_DEV_API_PROXY=https://185-10-20-30.sslip.io
VITE_DEV_API_PROXY=

# Public HTTPS/HTTP origin baked into index.html OG/Twitter meta tags at build/dev time.
# Must match the URL users open in the browser (no trailing slash).
# Local dev default:
VITE_PUBLIC_ORIGIN=http://localhost:5173
#
# Production: set VITE_PUBLIC_ORIGIN in the root `.env` (Docker build arg).
# Must match CLIENT_URL in server/.production.env:
# VITE_PUBLIC_ORIGIN=https://185-10-20-30.sslip.io

# Operator contact email shown on the /privacy page (data-subject requests, 152-ФЗ / GDPR).
# Baked into the build; leave empty to show a placeholder. For production set it in the root `.env`
# (passed as a Docker build arg to client-prod). Use a dedicated mailbox — it becomes public.
VITE_PRIVACY_CONTACT_EMAIL=
