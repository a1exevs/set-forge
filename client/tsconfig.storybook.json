{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "types": ["node"]
  },
  "include": [
    ".storybook/**/*",
    "src/vite-env.d.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.mdx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "storybook-static"
  ]
}
