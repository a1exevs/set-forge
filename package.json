{
  "name": "@set-forge/workspace",
  "private": true,
  "description": "Build workout lists, log sets and weights, rate perceived effort, and track strength progress over time.",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": "22.23.3",
    "npm": "10.9.9"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.ts",
    "prepare": "node -e \"if (process.env.HUSKY === '0') process.exit(0); const {existsSync}=require('node:fs'); if (existsSync('node_modules/husky')) require('node:child_process').execSync('husky install',{stdio:'inherit'});\"",
    "format:root": "prettier --write \"scripts/**/*.ts\" eslint.config.ts",
    "format:root:check": "prettier --check \"scripts/**/*.ts\" eslint.config.ts",
    "lint:root": "npm run lint:scripts && npm run lint:config && npm run lint:eslint && npm run lint:docs",
    "lint:scripts": "tsc -p scripts/tsconfig.json",
    "lint:config": "tsc -p tsconfig.json",
    "lint:eslint": "eslint scripts lint-staged.config.cjs eslint.config.ts",
    "lint:eslint:fix": "eslint scripts lint-staged.config.cjs eslint.config.ts --fix",
    "lint:docs": "node scripts/check-domain-docs.ts",
    "version:patch": "node scripts/increase-version.ts patch",
    "version:minor": "node scripts/increase-version.ts minor",
    "version:major": "node scripts/increase-version.ts major",
    "update-version:patch": "node scripts/update-version.ts patch",
    "update-version:minor": "node scripts/update-version.ts minor",
    "update-version:major": "node scripts/update-version.ts major",
    "client:dev": "npm run dev -w @set-forge/client",
    "client:build": "npm run build -w @set-forge/client",
    "client:preview": "npm run preview -w @set-forge/client",
    "client:format": "npm run format -w @set-forge/client",
    "client:format:check": "npm run format:check -w @set-forge/client",
    "client:lint": "npm run lint -w @set-forge/client",
    "client:lint:structure": "npm run lint:structure -w @set-forge/client",
    "client:lint:stories": "npm run lint:stories -w @set-forge/client",
    "client:lint:rules": "npm run lint:rules -w @set-forge/client",
    "client:lint:config": "npm run lint:config -w @set-forge/client",
    "client:lint:eslint": "npm run lint:eslint -w @set-forge/client",
    "client:lint:eslint:fix": "npm run lint:eslint:fix -w @set-forge/client",
    "client:lint:fsd": "npm run lint:fsd -w @set-forge/client",
    "client:lint:unused": "npm run lint:unused -w @set-forge/client",
    "client:test:unit": "npm run test:unit -w @set-forge/client",
    "client:test:unit-cov": "npm run test:unit-cov -w @set-forge/client",
    "client:test:snap": "npm run test:snap -w @set-forge/client",
    "client:test:snap-cov": "npm run test:snap-cov -w @set-forge/client",
    "client:test:snap-update": "npm run test:snap-update -w @set-forge/client",
    "client:test:e2e": "npm run test:e2e -w @set-forge/client",
    "client:test:e2e:headed": "npm run test:e2e:headed -w @set-forge/client",
    "client:test:e2e:ui": "npm run test:e2e:ui -w @set-forge/client",
    "client:test:e2e:debug": "npm run test:e2e:debug -w @set-forge/client",
    "client:test": "npm run test -w @set-forge/client",
    "client:storybook": "npm run storybook -w @set-forge/client",
    "client:build-storybook": "npm run build-storybook -w @set-forge/client",
    "client:chromatic": "npm run chromatic -w @set-forge/client",
    "client:docs": "npm run docs -w @set-forge/client",
    "client:generate:icons": "npm run generate:icons -w @set-forge/client",
    "client:e2e:install": "npm run e2e:install -w @set-forge/client",
    "client:stand": "npm run stand -w @set-forge/client --",
    "client:stand:stop": "npm run stand:stop -w @set-forge/client --",
    "client:check-deps": "npm run check-deps -w @set-forge/client",
    "client:upgrade-deps": "npm run upgrade-deps -w @set-forge/client",
    "server:start": "npm run start -w @set-forge/server",
    "server:start:dev": "npm run start:dev -w @set-forge/server",
    "server:start:debug": "npm run start:debug -w @set-forge/server",
    "server:start:prod": "npm run start:prod -w @set-forge/server",
    "server:build": "npm run build -w @set-forge/server",
    "server:format": "npm run format -w @set-forge/server",
    "server:format:check": "npm run format:check -w @set-forge/server",
    "server:lint": "npm run lint -w @set-forge/server",
    "server:lint:config": "npm run lint:config -w @set-forge/server",
    "server:lint:eslint": "npm run lint:eslint -w @set-forge/server",
    "server:lint:eslint:fix": "npm run lint:eslint:fix -w @set-forge/server",
    "server:test:unit": "npm run test:unit -w @set-forge/server",
    "server:test:unit-watch": "npm run test:unit-watch -w @set-forge/server",
    "server:test:unit-cov": "npm run test:unit-cov -w @set-forge/server",
    "server:test:unit-debug": "npm run test:unit-debug -w @set-forge/server",
    "server:test:e2e": "npm run test:e2e -w @set-forge/server",
    "server:db:migrate": "npm run db:migrate -w @set-forge/server",
    "server:db:migrate:undo": "npm run db:migrate:undo -w @set-forge/server",
    "server:db:migrate:undo:all": "npm run db:migrate:undo:all -w @set-forge/server",
    "server:db:migrate:status": "npm run db:migrate:status -w @set-forge/server",
    "server:db:seed": "npm run db:seed -w @set-forge/server",
    "server:db:seed:undo": "npm run db:seed:undo -w @set-forge/server",
    "server:check-deps": "npm run check-deps -w @set-forge/server",
    "server:upgrade-deps": "npm run upgrade-deps -w @set-forge/server",
    "db:up": "docker compose --profile dev up -d mysql-dev",
    "db:down": "docker compose --profile dev down",
    "db:logs": "docker compose logs -f mysql-dev",
    "prod:up": "docker compose --profile prod up --build -d",
    "prod:down": "docker compose --profile prod down",
    "prod:logs": "docker compose logs -f caddy server-prod client-prod mysql",
    "prod:db:migrate": "docker compose --profile prod exec server-prod npx sequelize-cli db:migrate",
    "prod:db:migrate:undo": "docker compose --profile prod exec server-prod npx sequelize-cli db:migrate:undo",
    "prod:db:migrate:status": "docker compose --profile prod exec server-prod npx sequelize-cli db:migrate:status",
    "prod:db:seed": "docker compose --profile prod exec server-prod npx sequelize-cli db:seed:all",
    "prod:db:seed:undo": "docker compose --profile prod exec server-prod npx sequelize-cli db:seed:undo:all"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.1",
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "globals": "16.5.0",
    "husky": "8.0.3",
    "jiti": "2.7.0",
    "lint-staged": "13.3.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
