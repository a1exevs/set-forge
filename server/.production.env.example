# Copy to server/.production.env. Loaded by `server-prod` via `env_file:` in docker-compose.yml.
# In the prod compose stack the SPA and the Nest API live behind Caddy on the SAME origin (SITE_ADDRESS),
# so SERVER_URL and CLIENT_URL must match what the browser sees.

# Examples:
#   Local HTTPS check on 443:  SERVER_URL=https://localhost              CLIENT_URL=https://localhost
#   Local HTTPS check on 8443: SERVER_URL=https://localhost:8443         CLIENT_URL=https://localhost:8443
#   sslip.io on a VDS:        SERVER_URL=https://<ip>.sslip.io          CLIENT_URL=https://<ip>.sslip.io
#   Real domain:              SERVER_URL=https://set-forge.example.com  CLIENT_URL=https://set-forge.example.com
SERVER_URL=https://localhost
CLIENT_URL=https://localhost
PORT=5000

# `mysql` is the docker-compose service name (do not use localhost — that points to the container itself).
MYSQL_HOST=mysql
MYSQL_USER=set_forge_db_user
MYSQL_DB=set_forge_db
MYSQL_PASSWORD=set_forge_db_password
MYSQL_PORT=3306

SERVER_STATIC=static
JWT_SECRET_KEY=set_forge_long_random_value
SESSION_SECRET_KEY=set_forge_long_random_value
SERVER_LOGS=logs
