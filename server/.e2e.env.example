CLIENT_URL=http://localhost:5174
PORT=5101

SERVER_STATIC=static-test
SERVER_LOGS=logger-test
JWT_SECRET_KEY=set_forge_e2e_jwt_secret
SIGN_IN_LIMIT_SECRET_KEY=set_forge_e2e_sign_in_limit_secret

# MYSQL_* and REDIS_* are injected at runtime by Testcontainers
# (server Jest e2e: test/e2e/global-setup.ts; client Playwright: tests/e2e/stack/start-api-stack.ts)

# SIGN_IN_ATTEMPTS_PER_MINUTE and TRUST_PROXY_HOPS are set by the same scripts: the suites sign in far more often
# than a person, and they act from other addresses through X-Forwarded-For.
