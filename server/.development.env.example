SERVER_URL=http://localhost
CLIENT_URL=http://localhost:5173
PORT=5001

MYSQL_HOST=localhost
MYSQL_USER=set_forge_db_user
MYSQL_DB=set_forge_db
MYSQL_PASSWORD=set_forge_db_password
MYSQL_PORT=3306

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_STATIC=static
JWT_SECRET_KEY=set_forge_long_random_value
SIGN_IN_LIMIT_SECRET_KEY=set_forge_long_random_value
SERVER_LOGS=logs

# Current versions of the legal documents (default 1). Bump when a document changes materially —
# users who accepted an older version are prompted to re-accept on their next visit.
TERMS_VERSION=1
PRIVACY_VERSION=1
