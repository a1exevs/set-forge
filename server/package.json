{
  "name": "@set-forge/server",
  "version": "0.6.2",
  "description": "Build workout lists, log sets and weights, rate perceived effort, and track strength progress over time.",
  "private": true,
  "author": "AlexEvs",
  "bugs": {
    "url": "https://github.com/a1exevs/set-forge/issues"
  },
  "keywords": [
    "exercise lists",
    "workout",
    "training",
    "progress visualization",
    "sport",
    "exercises",
    "workout planning"
  ],
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "build": "nest build",
    "format": "prettier --write \"{src,test,linter}/**/*.{ts,tsx}\" \"eslint.config.ts\"",
    "format:check": "prettier --check \"{src,test,linter}/**/*.{ts,tsx}\" \"eslint.config.ts\"",
    "lint": "eslint --config eslint.config.ts src test linter eslint.config.ts",
    "lint:fix": "eslint --config eslint.config.ts src test linter eslint.config.ts --fix",
    "test:unit": "tsc --noEmit -p tsconfig.test.json && jest",
    "test:unit-watch": "jest --watch",
    "test:unit-cov": "tsc --noEmit -p tsconfig.test.json && jest --coverage",
    "test:unit-debug": "cross-env NODE_OPTIONS=--inspect-brk jest --runInBand",
    "test:e2e": "tsc --noEmit -p tsconfig.test.json && jest --config jest-e2e.json --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "check-deps": "npm outdated",
    "upgrade-deps": "npm upgrade --latest"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/sequelize": "11.0.1",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "cross-env": "10.1.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "mysql2": "3.23.3",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "0.1.14",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-cli": "6.6.5",
    "sequelize-typescript": "2.1.6",
    "svg-captcha": "1.4.0",
    "swagger-ui-express": "5.0.1",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.0",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@testcontainers/mysql": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/sequelize": "6.12.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "chai": "6.2.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "jest-mock": "30.4.1",
    "jiti": "2.7.0",
    "node-mocks-http": "1.18.1",
    "prettier": "3.5.3",
    "sequelize-mock": "0.10.2",
    "sequelize-test-helpers": "1.4.3",
    "sinon": "22.1.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "testcontainers": "^12.0.1",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "./test-environment.ts",
      "./string.extensions.ts"
    ],
    "moduleNameMapper": {
      "@root/(.*)$": [
        "<rootDir>/$1"
      ],
      "@src/(.*)$": [
        "<rootDir>/src/$1"
      ],
      "@auth/(.*)$": [
        "<rootDir>/src/auth/$1"
      ],
      "@common/(.*)$": [
        "<rootDir>/src/common/$1"
      ],
      "@logger/(.*)$": [
        "<rootDir>/src/logger/$1"
      ],
      "@roles/(.*)$": [
        "<rootDir>/src/roles/$1"
      ],
      "@security/(.*)$": [
        "<rootDir>/src/security/$1"
      ],
      "@users/(.*)$": [
        "<rootDir>/src/users/$1"
      ],
      "@workout-lists/(.*)$": [
        "<rootDir>/src/workout-lists/$1"
      ],
      "@workout-sessions/(.*)$": [
        "<rootDir>/src/workout-sessions/$1"
      ],
      "@test/(.*)$": [
        "<rootDir>/test/$1"
      ],
      "@assets/(.*)$": [
        "<rootDir>/assets/$1"
      ]
    }
  }
}
