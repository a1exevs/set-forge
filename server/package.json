{
  "name": "@set-forge/server",
  "version": "0.6.2",
  "description": "Build workout lists, log sets and weights, rate perceived effort, and track strength progress over time.",
  "private": true,
  "author": "AlexEvs",
  "bugs": {
    "url": "https://github.com/a1exevs/set-forge/issues"
  },
  "keywords": [
    "exercise lists",
    "workout",
    "training",
    "progress visualization",
    "sport",
    "exercises",
    "workout planning"
  ],
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production nest start",
    "start:dev": "cross-env NODE_ENV=development nest start --watch",
    "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test:unit": "tsc --noEmit -p tsconfig.test.json && jest",
    "test:unit-watch": "jest --watch",
    "test:unit-cov": "tsc --noEmit -p tsconfig.test.json && jest --coverage",
    "test:unit-debug": "cross-env NODE_OPTIONS=--inspect-brk jest --runInBand",
    "test:e2e": "tsc --noEmit -p tsconfig.test.json && jest --config jest-e2e.json --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "check-deps": "npm outdated",
    "upgrade-deps": "npm upgrade --latest"
  },
  "dependencies": {
    "@nestjs/common": "9.4.3",
    "@nestjs/config": "2.3.4",
    "@nestjs/core": "9.4.3",
    "@nestjs/jwt": "9.0.0",
    "@nestjs/platform-express": "9.4.3",
    "@nestjs/sequelize": "9.0.2",
    "@nestjs/serve-static": "3.0.1",
    "@nestjs/swagger": "6.3.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "cross-env": "7.0.3",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-unicorn": "44.0.2",
    "express": "4.22.2",
    "express-session": "1.19.0",
    "mysql2": "2.3.3",
    "pg": "8.22.0",
    "pg-hstore": "2.3.4",
    "reflect-metadata": "0.1.14",
    "rimraf": "3.0.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-cli": "6.6.5",
    "sequelize-typescript": "2.1.6",
    "svg-captcha": "1.4.0",
    "swagger-ui-express": "4.6.3",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.0",
    "@nestjs/cli": "9.5.0",
    "@nestjs/schematics": "9.2.0",
    "@nestjs/testing": "9.4.3",
    "@testcontainers/mysql": "12.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/express-session": "1.19.0",
    "@types/jest": "29.5.14",
    "@types/node": "18.19.130",
    "@types/sequelize": "4.28.20",
    "@types/supertest": "2.0.16",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-nestjs": "1.2.3",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "jest-mock": "29.7.0",
    "node-mocks-http": "1.18.1",
    "prettier": "3.5.3",
    "sequelize-mock": "0.10.2",
    "sequelize-test-helpers": "1.4.3",
    "sinon": "14.0.2",
    "source-map-support": "0.5.21",
    "supertest": "6.3.4",
    "testcontainers": "^12.0.1",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "./test-environment.ts",
      "./string.extensions.ts"
    ],
    "moduleNameMapper": {
      "@root/(.*)$": [
        "<rootDir>/$1"
      ],
      "@src/(.*)$": [
        "<rootDir>/src/$1"
      ],
      "@auth/(.*)$": [
        "<rootDir>/src/auth/$1"
      ],
      "@common/(.*)$": [
        "<rootDir>/src/common/$1"
      ],
      "@logger/(.*)$": [
        "<rootDir>/src/logger/$1"
      ],
      "@roles/(.*)$": [
        "<rootDir>/src/roles/$1"
      ],
      "@security/(.*)$": [
        "<rootDir>/src/security/$1"
      ],
      "@users/(.*)$": [
        "<rootDir>/src/users/$1"
      ],
      "@workout-lists/(.*)$": [
        "<rootDir>/src/workout-lists/$1"
      ],
      "@workout-sessions/(.*)$": [
        "<rootDir>/src/workout-sessions/$1"
      ],
      "@test/(.*)$": [
        "<rootDir>/test/$1"
      ],
      "@assets/(.*)$": [
        "<rootDir>/assets/$1"
      ]
    }
  }
}
